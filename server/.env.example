# ─────────────────────────────────────────────────────────────────────────────
# AI Moodify — Server Environment Variables
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git — it is listed in .gitignore.
# ─────────────────────────────────────────────────────────────────────────────

# YouTube Data API v3 key — used for dynamic Bollywood song search
# Obtain from: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# PostgreSQL Database Configuration
# Option 1: Connection string (Recommended for Neon DB / hosted databases)
DATABASE_URL=postgresql://neondb_owner:password@ep-host-name.aws.neon.tech/moodify?sslmode=require

# Option 2: Individual variables (Fallback for local PostgreSQL)
# PGUSER=postgres
# PGPASSWORD=your_postgres_password
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=moodify

# JSON Web Token Secret (use a long random value in production)
JWT_SECRET=moodify_super_secret_key_123

# Auth cookies — set NODE_ENV=production for secure + SameSite=strict cookies
NODE_ENV=development
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7

# Server Scaling / Clustering Configuration
# Set to 'true' to enable multi-core forking (for college presentations / demos)
# Set to 'false' or omit to run as a clean single process (recommended for development)
USE_CLUSTER=false

# AI Pipeline Server Endpoint
# Default is http://localhost:8000 for local runs. Inside Docker Compose, set to http://ai-pipeline:8000.
AI_PIPELINE_URL=http://localhost:8000
